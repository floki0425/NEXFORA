{
  "name": "nexfora-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "npm run test:core && npm run test:phase8 && npm run test:phase9 && npm run test:phase10 && npm run test:phase11",
    "test:core": "node --experimental-test-module-mocks --import ./tests/support/register-app-alias-loader.mjs --test tests/auth/password-recovery.test.mjs tests/auth/callback-route.test.mjs tests/auth/update-password-action.test.mjs tests/leads/lead-foundation.test.mjs tests/clients/client-management.test.mjs tests/projects/project-management.test.mjs tests/proposals/proposal-system.test.mjs tests/portal/client-portal.test.mjs tests/files/project-files.test.mjs tests/revisions/revisions.test.mjs",
    "test:phase8:unit": "node --test tests/phase8/unit/file-validation.test.mjs tests/phase8/unit/storage-path.test.mjs tests/phase8/unit/revision-validation.test.mjs tests/phase8/unit/revision-transitions.test.mjs tests/phase8/unit/error-and-cleanup.test.mjs",
    "test:phase8:integration": "node --test --test-concurrency=1 tests/phase8/integration/rls-files-and-revisions.test.mjs tests/phase8/integration/storage.test.mjs tests/phase8/integration/revision-workflow.test.mjs",
    "test:phase8": "npm run test:phase8:unit && npm run test:phase8:integration",
    "dev:e2e:phase8": "node scripts/start-phase8-e2e-server.mjs",
    "test:e2e:phase8": "playwright test",
    "test:phase8:all": "npm run test:phase8 && npm run test:e2e:phase8",
    "test:phase9": "npm run test:phase9:unit && npm run test:phase9:integration",
    "test:e2e:phase9": "playwright test --config=playwright.phase9.config.ts",
    "test:phase9:all": "npm run test:phase9 && npm run test:e2e:phase9",
    "test:phase10:unit": "node --test --test-isolation=none tests/phase10/unit/migration-schema-and-numbering.test.mjs tests/phase10/unit/migration-support-workflow.test.mjs tests/phase10/unit/migration-subscription-ledger.test.mjs tests/phase10/unit/migration-rls-authorization.test.mjs tests/phase10/unit/schemas-permissions-and-format.test.mjs",
    "test:phase10:integration": "node --test --test-isolation=none --test-concurrency=1 tests/phase10/integration/support-workflow.test.mjs tests/phase10/integration/subscriptions-and-rls.test.mjs",
    "test:phase10": "npm run test:phase10:unit && npm run test:phase10:integration",
    "dev:e2e:phase10": "node scripts/start-phase10-e2e-server.mjs",
    "test:e2e:phase10": "playwright test --config=playwright.phase10.config.ts",
    "test:phase10:all": "npm run test:phase10 && npm run test:e2e:phase10",
    "reset-owner-password": "node --env-file=.env.local scripts/reset-owner-password.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "dev:e2e:phase9": "node scripts/start-phase9-e2e-server.mjs",
    "test:phase9:unit": "node --test tests/phase9/unit/schemas-and-format.test.mjs tests/phase9/unit/permissions.test.mjs tests/phase9/unit/paymongo-webhook-signature.test.mjs tests/phase9/unit/paymongo-money.test.mjs tests/phase9/unit/migration-invoice-numbering.test.mjs tests/phase9/unit/migration-status-and-void-rules.test.mjs tests/phase9/unit/migration-payment-and-rls-rules.test.mjs",
    "test:phase9:integration": "node --test --test-concurrency=1 tests/phase9/integration/invoice-lifecycle.test.mjs tests/phase9/integration/rls-invoices-and-payments.test.mjs tests/phase9/integration/manual-payments.test.mjs tests/phase9/integration/paymongo-and-webhook.test.mjs tests/phase9/integration/overdue-status.test.mjs",
    "test:phase11:unit": "node --experimental-test-module-mocks --import ./tests/support/register-app-alias-loader.mjs --test tests/phase11/unit/event-types.test.mjs tests/phase11/unit/migration-schema-and-constraints.test.mjs tests/phase11/unit/migration-emit-and-triggers.test.mjs tests/phase11/unit/audit-metadata.test.mjs tests/phase11/unit/dedupe-key.test.mjs tests/phase11/unit/preferences.test.mjs tests/phase11/unit/cron-secret.test.mjs tests/phase11/unit/retry-backoff.test.mjs tests/phase11/unit/notification-email-template.test.mjs tests/phase11/unit/event-atomicity.test.mjs tests/phase11/unit/cron-route.test.mjs tests/phase11/unit/delivery-lease.test.mjs tests/phase11/unit/claim-identity.test.mjs",
    "test:phase11:integration": "node --test --test-concurrency=1 tests/phase11/integration/event-emission.test.mjs tests/phase11/integration/rls-notifications-and-audit.test.mjs tests/phase11/integration/audit-immutability.test.mjs tests/phase11/integration/reminders.test.mjs tests/phase11/integration/delivery-outbox.test.mjs tests/phase11/integration/delivery-lease.test.mjs tests/phase11/integration/stale-worker-result.test.mjs tests/phase11/integration/cross-tenant.test.mjs tests/phase11/integration/event-atomicity.test.mjs",
    "test:phase11": "npm run test:phase11:unit && npm run test:phase11:integration",
    "dev:e2e:phase11": "node scripts/start-phase11-e2e-server.mjs",
    "test:e2e:phase11": "playwright test --config=playwright.phase11.config.ts",
    "test:phase11:all": "npm run test:phase11 && npm run test:e2e:phase11",
    "test:phase12:unit": "node --import ./tests/support/register-app-alias-loader.mjs --test tests/phase12/unit/migration-reporting-schema.test.mjs tests/phase12/unit/migration-search-authorization.test.mjs tests/phase12/unit/migration-indexes.test.mjs tests/phase12/unit/migration-input-boundaries.test.mjs tests/phase12/unit/metric-definitions.test.mjs tests/phase12/unit/report-filters-schema.test.mjs tests/phase12/unit/manila-date-range.test.mjs tests/phase12/unit/search-sanitize.test.mjs tests/phase12/unit/permissions.test.mjs tests/phase12/unit/search-result-mapping.test.mjs tests/phase12/unit/search-result-status.test.mjs tests/phase12/unit/report-response-mapping.test.mjs",
    "test:phase12:integration": "node --test --test-concurrency=1 tests/phase12/integration/fixture-lifecycle.test.mjs tests/phase12/integration/lead-conversion-report.test.mjs tests/phase12/integration/lead-source-report.test.mjs tests/phase12/integration/proposal-win-rate.test.mjs tests/phase12/integration/revenue-report.test.mjs tests/phase12/integration/project-delivery-report.test.mjs tests/phase12/integration/report-authorization.test.mjs tests/phase12/integration/search-entity-permission-matrix.test.mjs tests/phase12/integration/search-bounds.test.mjs tests/phase12/integration/cross-tenant.test.mjs",
    "test:phase12": "npm run test:phase12:unit && npm run test:phase12:integration",
    "dev:e2e:phase12": "node scripts/start-phase12-e2e-server.mjs",
    "test:e2e:phase12": "playwright test --config=playwright.phase12.config.ts",
    "test:phase12:all": "npm run test:phase12:unit && npm run test:phase12:integration && npm run test:e2e:phase12"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.3",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "lucide-react": "^1.26.0",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.83.0",
    "resend": "^6.18.1",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "supabase": "^2.109.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
