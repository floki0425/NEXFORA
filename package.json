{
  "name": "nexfora-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "npm run test:core && npm run test:phase8 && npm run test:phase9",
    "test:core": "node --test tests/auth/password-recovery.test.mjs tests/leads/lead-foundation.test.mjs tests/clients/client-management.test.mjs tests/projects/project-management.test.mjs tests/proposals/proposal-system.test.mjs tests/portal/client-portal.test.mjs tests/files/project-files.test.mjs tests/revisions/revisions.test.mjs",
    "test:phase8:unit": "node --test tests/phase8/unit/file-validation.test.mjs tests/phase8/unit/storage-path.test.mjs tests/phase8/unit/revision-validation.test.mjs tests/phase8/unit/revision-transitions.test.mjs tests/phase8/unit/error-and-cleanup.test.mjs",
    "test:phase8:integration": "node --test --test-concurrency=1 tests/phase8/integration/rls-files-and-revisions.test.mjs tests/phase8/integration/storage.test.mjs tests/phase8/integration/revision-workflow.test.mjs",
    "test:phase8": "npm run test:phase8:unit && npm run test:phase8:integration",
    "dev:e2e:phase8": "node scripts/start-phase8-e2e-server.mjs",
    "test:e2e:phase8": "playwright test",
    "test:phase8:all": "npm run test:phase8 && npm run test:e2e:phase8",
    "test:phase9:unit": "node --test tests/phase9/unit/schemas-and-format.test.mjs tests/phase9/unit/permissions.test.mjs tests/phase9/unit/paymongo-webhook-signature.test.mjs tests/phase9/unit/paymongo-money.test.mjs tests/phase9/unit/migration-invoice-numbering.test.mjs tests/phase9/unit/migration-status-and-void-rules.test.mjs tests/phase9/unit/migration-payment-and-rls-rules.test.mjs",
    "test:phase9:integration": "node --test --test-concurrency=1 tests/phase9/integration/invoice-lifecycle.test.mjs tests/phase9/integration/rls-invoices-and-payments.test.mjs tests/phase9/integration/manual-payments.test.mjs tests/phase9/integration/paymongo-and-webhook.test.mjs tests/phase9/integration/overdue-status.test.mjs",
    "test:phase9": "npm run test:phase9:unit && npm run test:phase9:integration",
    "test:e2e:phase9": "playwright test --config=playwright.phase9.config.ts",
    "test:phase9:all": "npm run test:phase9 && npm run test:e2e:phase9",
    "reset-owner-password": "node --env-file=.env.local scripts/reset-owner-password.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.3",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "lucide-react": "^1.26.0",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.83.0",
    "resend": "^6.18.1",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "supabase": "^2.109.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
