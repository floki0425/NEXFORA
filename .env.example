# Public application configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only configuration
SUPABASE_SECRET_KEY=

# Optional: required only to send proposal emails (Phase 6). When unset, the
# proposal send action reports a safe setup error instead of failing silently.
RESEND_API_KEY=
EMAIL_FROM=

# Phase 8 automated tests only (npm run test:phase8 / test:e2e:phase8). Must
# point at a dedicated, non-production Supabase project — never production.
# See docs/PHASE_8_AUTOMATED_TESTING.md. Put real values in .env.test.local
# (already gitignored), never here and never committed.
TEST_SUPABASE_URL=
TEST_SUPABASE_PUBLISHABLE_KEY=
TEST_SUPABASE_SECRET_KEY=

# Phase 8 Playwright E2E only. TEST_APP_URL is the already-running app under
# test, started against the same TEST_SUPABASE_* project above.
TEST_APP_URL=http://localhost:3000
TEST_INTERNAL_ADMIN_EMAIL=
TEST_INTERNAL_ADMIN_PASSWORD=
TEST_CLIENT_OWNER_EMAIL=
TEST_CLIENT_OWNER_PASSWORD=
TEST_CLIENT_VIEWER_EMAIL=
TEST_CLIENT_VIEWER_PASSWORD=
