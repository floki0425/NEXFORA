# Public application configuration
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only configuration
SUPABASE_SECRET_KEY=

# Optional: required only to send proposal/invoice emails (Phase 6, Phase 9).
# When unset, the send action reports a safe setup error instead of failing
# silently.
RESEND_API_KEY=
EMAIL_FROM=

# Optional: required only for PayMongo online payments (Phase 9). When
# unset, "Pay online" reports a safe setup error and the webhook route
# rejects every request instead of accepting unverified ones. Never commit
# real values — see docs/PHASE_9_INVOICES_PAYMENTS_SETUP.md.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Optional: required only for the scheduled reminders cron route (Phase 11,
# POST /api/cron/reminders). When unset, the route fails closed with 401 on
# every request instead of accepting unauthenticated ones. The "Run
# reminders now" manual admin action does not use this route and works
# without it. Generate with a long random string (32+ characters) and set
# the same value in Vercel's cron configuration. Never commit real values.
CRON_SECRET=

# Optional: required only to receive project inquiries forwarded from the
# Nexfora public website (OS-L1, POST /api/webhooks/website-inquiry). The
# same value must be set on the website as NEXFORA_OS_INQUIRY_WEBHOOK_SECRET.
# When unset, the route rejects every request with 401 instead of accepting
# unsigned ones; website submissions still succeed and are simply not synced.
# Generate a long random string (32+ characters). Never commit real values.
WEBSITE_INQUIRY_WEBHOOK_SECRET=

# Phase 8 automated tests only (npm run test:phase8 / test:e2e:phase8). Must
# point at a dedicated, non-production Supabase project — never production.
# See docs/PHASE_8_AUTOMATED_TESTING.md. Put real values in .env.test.local
# (already gitignored), never here and never committed.
TEST_SUPABASE_URL=
TEST_SUPABASE_PUBLISHABLE_KEY=
TEST_SUPABASE_SECRET_KEY=

# Phase 8 Playwright E2E only. Playwright starts the app at TEST_APP_URL and
# maps the TEST_SUPABASE_* values above to the app's public/server variable
# names. No separate `npm run dev` process is required.
TEST_APP_URL=http://localhost:3000
TEST_INTERNAL_ADMIN_EMAIL=
TEST_INTERNAL_ADMIN_PASSWORD=
TEST_CLIENT_OWNER_EMAIL=
TEST_CLIENT_OWNER_PASSWORD=
TEST_CLIENT_VIEWER_EMAIL=
TEST_CLIENT_VIEWER_PASSWORD=

# Phase 9 Playwright E2E only (npm run test:e2e:phase9). Deliberately
# separate accounts from TEST_INTERNAL_ADMIN_EMAIL/TEST_CLIENT_OWNER_EMAIL
# above — reusing them would give one auth user active memberships in two
# different E2E organizations at once, which requireInternalMember() and
# private.active_client_id() both fail closed on. See
# docs/PHASE_9_INVOICES_PAYMENTS_SETUP.md.
TEST_P9_INTERNAL_ADMIN_EMAIL=
TEST_P9_INTERNAL_ADMIN_PASSWORD=
TEST_P9_CLIENT_OWNER_EMAIL=
TEST_P9_CLIENT_OWNER_PASSWORD=

# Phase 11 Playwright E2E only (npm run test:e2e:phase11). Deliberately
# separate accounts from every TEST_*_EMAIL above, for the same
# multi-organization-membership reason documented next to TEST_P9_* — see
# docs/PHASE_11_NOTIFICATIONS_SETUP.md. TEST_P11_INTERNAL_ADMIN_EMAIL must be
# super_admin (audit log access + "Run reminders now"); TEST_P11_TEAM_MEMBER
# is used for the audit-log permission-denied assertion; TEST_P11_CLIENT_OWNER
# is used for the portal-no-notifications assertion.
TEST_P11_INTERNAL_ADMIN_EMAIL=
TEST_P11_INTERNAL_ADMIN_PASSWORD=
TEST_P11_TEAM_MEMBER_EMAIL=
TEST_P11_TEAM_MEMBER_PASSWORD=
TEST_P11_CLIENT_OWNER_EMAIL=
TEST_P11_CLIENT_OWNER_PASSWORD=
