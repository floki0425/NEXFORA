# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/blob-report
/playwright/.cache
tests/phase8/e2e/.e2e-fixture-ids.json
tests/phase9/e2e/.e2e-fixture-ids.json
tests/phase10/e2e/.e2e-fixture-ids.json

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# raw run logs. A committed test/CI log is a standing leak vector: it can
# capture headers, connection strings, or fixture credentials on a future
# failure. No tracked file matches *.log, so this excludes nothing needed.
*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# temporary credential artifacts
*.credentials
*.credentials.*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
tests/phase11/e2e/.e2e-fixture-ids.json
tests/phase12/e2e/.e2e-fixture-ids.json
/tests/phase12/e2e/evidence
